---
interface Props {
  state:
    | "deployed"
    | "in development"
    | "in progress"
    | "issue found"
    | "deprecated";
}
const { state } = Astro.props;
---

<span
  id="component-state"
  class:list={[
    "hidden capitalize rounded-sm px-1.5 py-1 text-[14px]",
    {
      "bg-[#DCFCE7] border border-[#4ADE80] text-[#15803D]":
        state === "deployed",
    },
    {
      "bg-[#DBEAFE] border border-[#93C5FD] text-[#1D4ED8]":
        state === "in development",
    },
    {
      "bg-[#FEF3C7] border border-[#FFC070] text-[#9E420E]":
        state === "in progress",
    },
    {
      "bg-[#FEE6E5] border border-[#F8A9AA] text-[#BC2439]":
        state === "issue found",
    },
    {
      "bg-[#F3F4F6] border border-[#64748B] text-[#475569]":
        state === "deprecated",
    },
  ]}
>
  {state}
</span>

<script>
  const title = document.querySelector("#_top") as HTMLHtmlElement;
  const tag = document.querySelector("#component-state") as HTMLHtmlElement;
  title.classList.add("flex", "gap-6", "justify-start", "items-center");
  title.appendChild(tag);
  (title.childNodes[1] as HTMLHtmlElement).classList.remove("hidden");
</script>
