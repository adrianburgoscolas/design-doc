<script>
  const cssVarList = document.querySelectorAll(".css-var");
  cssVarList.forEach((varList) => {
    varList.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(varList.innerHTML);
        alert("Text copied to clipboard!");
      } catch (err) {
        console.error("Failed to copy text: ", err);
        alert("Failed to copy text to clipboard.");
      }
    });
  });
</script>
