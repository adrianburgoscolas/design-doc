---
import { Icon } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import ImageModal from "./ImageModal.astro";

interface Props {
  canDo: boolean;
  image: ImageMetadata;
  text: string;
}
const { image, canDo, text } = Astro.props;
---

<div>
  <div
    class:list={[
      "rounded-3xl w-full h-auto",
      {
        "border-16 border-[var(--colors-blocks-rules-background-do,#bdf4e9)] dark:border-[var(--colors-blocks-rules-background-do,#273d39)]":
          canDo,
      },
      {
        "border-16 border-[var(--colors-blocks-rules-background-dont,#fce5e4)] dark:border-[var(--colors-blocks-rules-background-do,#691a10)]":
          !canDo,
      },
    ]}
  >
    <ImageModal
      animate={false}
      rounded={false}
      src={image}
      alt="components"
    />
  </div>
  <div
    class:list={[
      "flex items-center gap-1 w-fit rounded-full pl-3 pr-4",
      {
        " bg-[var(--colors-blocks-rules-background-do,#bdf4e9)] dark:bg-[var(--colors-blocks-rules-background-do,#273d39)]":
          canDo,
      },
      {
        "bg-[var(--colors-blocks-rules-background-dont,#fce5e4)] dark:bg-[var(--colors-blocks-rules-background-do,#691a10)]":
          !canDo,
      },
    ]}
  >
    <Icon name="approve-check" />
    {canDo && <span>Do</span>}

    {!canDo && <span>Don't</span>}
  </div>
  <p>{text}</p>
</div>
